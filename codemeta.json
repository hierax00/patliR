{
  "@context": "https://doi.org/10.5063/schema/codemeta-2.0",
  "@type": "SoftwareSourceCode",
  "identifier": "patliR",
  "description": "A field-to-report pipeline for network pharmacology analysis of natural product extracts and compound mixtures. Provides functions to import and validate compound identity from PubChem CIDs or SMILES, integrate physicochemical (ADME) properties and structural toxicity alerts, import or predict protein targets, build and analyze compound-target-pathway networks (centrality, modular robustness, network proximity to disease modules, synergy), audit database bias in network pharmacology results, and generate transparent, fully-logged reports. The pipeline is built around an immutable S4 project object: every step is a pure transformation (input project -> output project), and every intermediate result is written to a plain CSV file that acts as the durable, portable source of truth, independent of any R-specific binary format.",
  "name": "patliR: Reproducible Network Pharmacology Analysis for Natural Product Extracts",
  "codeRepository": "https://github.com/hierax00/patliR",
  "issueTracker": "https://github.com/hierax00/patliR/issues",
